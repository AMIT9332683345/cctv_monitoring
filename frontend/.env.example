# OPPS CCTV frontend (Vite). Copy to frontend/.env only when building locally.

# Cloud backend base URL (Render). Leave empty when the frontend is served by the
# gateway itself or when using the Vite dev proxy.
# Example: https://opps-cctv-api.onrender.com
VITE_API_URL=

# Optional comma-separated gateway URLs to probe for local mode before falling back
# to cloud mode. The gateway-served frontend probes its own origin automatically.
# Example: http://192.168.1.20:8089,http://100.101.102.103:8089
VITE_GATEWAY_URL=
