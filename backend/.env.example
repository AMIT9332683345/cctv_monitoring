# ---------------------------------------------------------------------------
# OPPS CCTV cloud backend (Render). Copy to backend/.env for local testing.
# Never commit the real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8787
HOST=0.0.0.0

# MongoDB Atlas connection string. Leave empty only for local development,
# where the backend falls back to an in-memory store (data lost on restart).
MONGODB_URI=
MONGODB_DB=opps_cctv
ALLOW_MEMORY_STORE=true

# 48+ random bytes, base64url. Must match the gateway's AUTH_SECRET so the
# backend can sign media URLs that the gateway accepts.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# One-time token required by POST /api/setup. 24+ random characters.
SETUP_TOKEN=

# Shared secret used by the Windows gateway for heartbeat + task polling.
# Must match GATEWAY_TOKEN in gateway/.env.
GATEWAY_TOKEN=

ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000

# Production (Vercel frontend -> Render backend) requires cross-site cookies:
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:8089

TRUST_PROXY=false
GATEWAY_ONLINE_WINDOW_SEC=45
LOG_LEVEL=info
