# OPPS CCTV — local gateway configuration
# Copy this file to gateway/.env and fill in real values. Never commit .env.

# --- Core ---
NODE_ENV=production
GATEWAY_PORT=8089
GATEWAY_HOST=0.0.0.0
GATEWAY_NAME=Home CCTV Gateway
# Where the gateway keeps state, HLS segments, exported clips and the buffer.
GATEWAY_DATA_DIR=./data
# Built frontend served by the gateway for local Wi-Fi access (npm run build at repo root).
STATIC_DIR=../frontend/dist

# --- Secrets (32+ chars, random) ---
# Must be identical to the backend AUTH_SECRET so media tokens validate on both sides.
AUTH_SECRET=
# Shared secret sent to the backend as X-Gateway-Token (must match backend GATEWAY_TOKEN).
GATEWAY_TOKEN=
# One-time token required to create the gateway owner when the request is not from localhost.
# Optional if you always set up the owner from the gateway PC itself.
GATEWAY_SETUP_TOKEN=
# Optional 64-hex-char key used to encrypt the DVR password at rest.
# If empty, gateway/data/master.key is generated on first run (keep it backed up).
GATEWAY_KEY=

# --- Cloud coordination (optional, required for remote/cloud jobs) ---
# Public HTTPS URL of the Render backend. Leave empty for a purely local setup.
BACKEND_URL=
GATEWAY_ID=gw-primary

# --- FFmpeg ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# copy = no transcode (lowest CPU), x264 = CPU transcode, nvenc = NVIDIA GPU transcode
HLS_ENCODER=copy
MAX_STREAMS=2
MAX_CONCURRENT_EXPORTS=1
EXPORT_TIMEOUT_MS=2700000

# --- Rolling buffer ---
BUFFER_SEGMENT_SEC=60
BUFFER_DISK_CAP_BYTES=21474836480

# --- Security ---
# Set to true when the gateway is served over HTTPS (required for cookies on HTTPS).
COOKIE_SECURE=false
# Extra origins allowed to call /gapi with credentials (e.g. https://your-app.vercel.app).
GATEWAY_ALLOWED_ORIGINS=
# Only enable if your DVR is NOT on a private LAN address (not recommended).
ALLOW_PUBLIC_DVR_HOSTS=false
# Optional TLS: absolute or relative paths to PEM files. Enables HTTPS for local LAN access.
TLS_CERT=
TLS_KEY=

# --- Logging ---
LOG_LEVEL=info
